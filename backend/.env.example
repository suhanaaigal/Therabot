AI_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
# Set OPENAI_API_KEY in the backend environment; never commit the actual key.
OLLAMA_MODEL=llama3.2
# For Ollama instead, set AI_PROVIDER=ollama and OPENAI_BASE_URL=http://127.0.0.1:11434/v1
PORT=5000
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/mental-health-db
