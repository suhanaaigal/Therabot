NODE_ENV=development
AI_PROVIDER=ollama
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2
AI_PROVIDER_TIMEOUT_MS=90000
PORT=5000
FRONTEND_URL=http://127.0.0.1:5173
MONGO_URI=
PATIENT_AUTH_SECRET=
DOCTOR_AUTH_SECRET=
# Local development only; no default clinician is created without this configured.
DEMO_DOCTOR_PASSWORD=
# Optional hosted OpenAI-compatible provider. Keys are never needed for local Ollama.
OPENAI_MODEL=
OPENAI_API_KEY=
# Optional emergency SMS integration; keep credentials private.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Local ML service for text stress and emotion analysis.
ML_URL=http://127.0.0.1:8000
# Optional absolute path to the generated S17 feature replay JSON on the backend host.
WESAD_REPLAY_PATH=
